# Sidekick Environment Configuration Template
# Copy this file to .env and fill in your private API keys.
# NEVER commit .env to version control!

# Primary Fast Inference Engine: Google Gemini (Recommended for sub-300ms latency)
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Deepgram Nova-2 Streaming Speech-To-Text WebSocket API Key
# Sign up at: https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Alternative Fast Inference LLM Providers
# Anthropic Claude 3.5 Haiku
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI GPT-4o-mini
OPENAI_API_KEY=your_openai_api_key_here

# Knowledge Base Directory
KNOWLEDGE_DOCS_DIR=./knowledge

# Tauri & HUD Runtime Environment
VITE_APP_ENV=development
