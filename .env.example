# Sidekick Environment Configuration Template
# Copy this file to .env and fill in your private API keys.
# NEVER commit .env to version control!

# Deepgram Nova-2 Streaming Speech-To-Text WebSocket API Key
# Sign up at: https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Fast Inference LLM Providers for RAG Generation (Choose one or both)
# Claude 3.5 Haiku (recommended for low-latency streaming reasoning)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI GPT-4o-mini (alternative low-latency option)
OPENAI_API_KEY=your_openai_api_key_here

# Vector Store / Knowledge Base Configuration
# Default: local embedded SQLite-vec or Qdrant
VECTOR_STORE_TYPE=embedded
KNOWLEDGE_DOCS_DIR=./knowledge

# Tauri & HUD Runtime Environment
VITE_APP_ENV=development
